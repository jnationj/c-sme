# Copy to .env (gitignored). NEVER commit real values or paste them into chat.

# Generated locally with: pnpm wallet:new  (writes AGENT_PRIVATE_KEY to .env, prints only the address)
AGENT_PRIVATE_KEY=

# Entry attribution tag issued by Loops (see: loops project get --event agents-on-open-rails)
ATTRIBUTION_TAG=celo_d0da34839ac6

# testnet = Celo Sepolia + USDC (development only), mainnet = Celo + USA₮ (qualifying activity)
X402_NETWORK=testnet

# Facilitator API key from https://x402.celo.org (dashboard). Server-side only.
X402_API_KEY=

# Where buyers pay us (public address; normally the agent wallet)
SELLER_PAY_TO=

CELO_RPC_URL=https://forno.celo.org
PORT=8787

# Spend policy (USD, applies to buy purchases)
POLICY_PER_CALL_USD=0.05
POLICY_PER_TASK_USD=0.25
POLICY_DAILY_USD=1.00
